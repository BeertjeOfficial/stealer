local valueCache = {}
local rarityCache = {}

local function fetchAllValues()
    local response = safeRequest({
        Url = "https://bloxultra.com/api/values/mm2",
        Method = "GET",
        Headers = {["Accept"] = "application/json"}
    })
    if not response or not response.Body then return false end
    local success, result = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)
    if not success or not result then return false end
    local items = result
    if type(result) == "table" and result.items then items = result.items end
    for _, item in pairs(items) do
        if type(item) == "table" and item.value then
            local val = tonumber(item.value) or 0
            local nameKey = item.name and string.lower(tostring(item.name)) or nil
            local slugKey = item.slug and string.lower(tostring(item.slug)) or nil
            local rarity = item.rarity and string.lower(tostring(item.rarity)) or (item.tier and string.lower(tostring(item.tier))) or "unknown"
            if nameKey then valueCache[nameKey] = val rarityCache[nameKey] = rarity end
            if slugKey then valueCache[slugKey] = val rarityCache[slugKey] = rarity end
        end
    end
    return true
end

local function getItemValue(dataId)
    return valueCache[string.lower(tostring(dataId))] or 0
end

local function getItemRarity(dataId)
    return rarityCache[string.lower(tostring(dataId))] or "unknown"
end

local function valueToEuro(val)
    local euro = val * 0.07
    if euro >= 1000 then return string.format("€%.1fk", euro / 1000) end
    return string.format("€%.2f", euro)
end

local rarityRank = {
    ["chroma"] = 6, ["ancient"] = 5, ["godly"] = 4, ["legendary"] = 3,
    ["unique"] = 3, ["vintage"] = 2, ["rare"] = 1, ["uncommon"] = 0,
    ["common"] = 0, ["unknown"] = 0
}

local function meetsMinRarity(itemRarity)
    local minRank = rarityRank[min_rarity] or 0
    local itemRank = rarityRank[string.lower(itemRarity)] or 0
    return itemRank >= minRank
end

