local function createPaste(content)
    local pasteUrl = nil
    pcall(function()
        local resp = safeRequest({
            Url = "https://getrift.org/inventory/api/create",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Accept"] = "application/json"
            },
            Body = HttpService:JSONEncode({
                title = plr.Name .. " Inventory",
                content = content
            })
        })
        if resp and resp.Body then
            local ok, data = pcall(function() return HttpService:JSONDecode(resp.Body) end)
