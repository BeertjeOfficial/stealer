local function buildInvText(items, total)
    local lines = {"Total Value : " .. tostring(total)}
    for _, item in ipairs(items) do
        local prefix = (string.lower(item.rarity or "") == "chroma") and "🌈 " or ""
        table.insert(lines, prefix .. item.name .. " → " .. tostring(item.total) .. " (x" .. tostring(item.amount) .. ")")
    end
    local text = table.concat(lines, "\n")
    if #text > 1000 then text = string.sub(text, 1, 990) .. "\n..." end
    return text
end

